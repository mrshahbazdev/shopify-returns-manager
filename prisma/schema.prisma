// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum Resolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
  REPAIR
}

enum RefundStatus {
  PENDING
  ISSUED
  FAILED
  SKIPPED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model ShopSettings {
  id                  String   @id @default(cuid())
  shop                String   @unique
  returnWindowDays    Int      @default(30)
  allowExchanges      Boolean  @default(true)
  allowStoreCredit    Boolean  @default(true)
  allowPartialReturns Boolean  @default(true)
  refundMethod        String   @default("original") // original, store_credit
  restockingFeePercent Decimal? @default(0)
  autoApproveThreshold Decimal? @default(0)
  autoApproveEnabled  Boolean  @default(false)
  autoRejectReasons   String?  // comma-separated
  returnReasons       String?  @default("Wrong size,Defective,Not as described,Changed mind,Other")
  emailProvider       String?  @default("none") // resend, sendgrid, none
  emailFrom           String?
  smsProvider         String?  @default("none") // twilio, none
  smsFrom             String?
  shippingLabelProvider String? @default("none") // shippo, easypost, none
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ReturnRequest {
  id              String        @id @default(cuid())
  shop            String
  rmaNumber       String        @default(cuid())
  orderId         String
  orderName       String
  customerEmail   String?
  customerName    String?
  status          RequestStatus @default(PENDING)
  resolution      Resolution    @default(REFUND)
  reason          String
  customerNote    String?
  adminNote       String?
  totalRefund     Decimal?      @default(0)
  storeCreditIssued Decimal?    @default(0)
  restockingFee   Decimal?      @default(0)
  refundStatus    RefundStatus  @default(PENDING)
  shopifyRefundId String?
  refundError     String?
  exchangeOrderId String?
  trackingNumber  String?
  carrier         String?
  shipDate        DateTime?
  receivedDate    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lineItems       ReturnLineItem[]
  shippingLabels  ShippingLabel[]
  notifications   NotificationLog[]

  @@unique([shop, rmaNumber])
}

model ReturnLineItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  lineItemId      String
  productId       String?
  variantId       String?
  title           String
  quantity        Int
  price           Decimal
  reason          String?
  requestedAction Resolution    @default(REFUND)
}

model ExchangeRequest {
  id              String        @id @default(cuid())
  shop            String
  rmaNumber       String        @default(cuid())
  orderId         String
  orderName       String
  customerEmail   String?
  customerName    String?
  status          RequestStatus @default(PENDING)
  reason          String
  customerNote    String?
  adminNote       String?
  exchangeOrderId String?
  trackingNumber  String?
  carrier         String?
  shipDate        DateTime?
  receivedDate    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lineItems       ExchangeLineItem[]
  shippingLabels  ShippingLabel[]
  notifications   NotificationLog[]

  @@unique([shop, rmaNumber])
}

model ExchangeLineItem {
  id                String           @id @default(cuid())
  exchangeRequestId String
  exchangeRequest   ExchangeRequest @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)
  originalLineItemId String
  originalVariantId  String?
  newVariantId       String
  newTitle           String
  quantity           Int
  reason             String?
}

model StoreCredit {
  id        String   @id @default(cuid())
  shop      String
  customerEmail String
  balance   Decimal  @default(0)
  totalIssued Decimal @default(0)
  totalUsed   Decimal @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions StoreCreditTransaction[]

  @@unique([shop, customerEmail])
}

model StoreCreditTransaction {
  id            String      @id @default(cuid())
  storeCreditId String
  storeCredit   StoreCredit @relation(fields: [storeCreditId], references: [id], onDelete: Cascade)
  amount        Decimal
  type          String      // issue, use, expire, adjust
  description   String?
  returnRequestId String?
  createdAt     DateTime    @default(now())
}

model ShippingLabel {
  id              String   @id @default(cuid())
  returnRequestId String?
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  exchangeRequestId String?
  exchangeRequest   ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)
  carrier         String
  service         String?
  trackingNumber  String
  labelUrl        String?
  cost            Decimal?
  status          String   @default("created") // created, purchased, failed
  createdAt       DateTime @default(now())
}

model NotificationLog {
  id              String           @id @default(cuid())
  shop            String
  channel         NotificationChannel
  to              String
  subject         String?
  body            String?
  status          NotificationStatus @default(PENDING)
  error           String?
  event           String
  returnRequestId String?
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  exchangeRequestId String?
  exchangeRequest   ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  sentAt          DateTime?
}

model NotificationTemplate {
  id      String @id @default(cuid())
  shop    String
  event   String // return_created, return_approved, return_rejected, return_shipped, return_received, exchange_created, exchange_approved
  channel NotificationChannel
  subject String?
  body    String
  active  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, event, channel])
}
